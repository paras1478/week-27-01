{
  "jobs": {
    "build": {
      "steps": [
        {
          "name": "Docker login",
          "uses": "docker/login-action@v2",
          "with": {
            "username": "${{ secrets.DOCKERHUB_USERNAME }}",
            "password": "${{ secrets.DOCKERHUB_TOKEN }}"
          }
        },
        {
          "name": "Build and push",
          "uses": "docker/build-push-action@v4",
          "with": {
            "context": "./",
            "file": "./docker/Dockerfile.backend",
            "push": true,
            "tags": "100xdevs/todo-app-backend:${{ github.sha }}"
          }
        }
      ]
    }
  }
}
